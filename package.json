{
  "name": "section-office",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "assets": "node scripts/prepare-images.mjs && node scripts/social-images.mjs",
    "build": "npm run assets && next build",
    "start": "node scripts/static-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "verify:export": "node scripts/verify-export.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/archivo": "5.3.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "opentype.js": "2.0.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
